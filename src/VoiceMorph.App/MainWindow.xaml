<Window x:Class="VoiceMorph.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="VoiceMorph" Width="1240" Height="870" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="13" Icon="Assets/VoiceMorph.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><DataTemplate x:Key="ProfileTemplate"><Grid MinHeight="98"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,12"/><TextBlock Grid.Row="2" Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Grid></DataTemplate></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Border Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><Image Source="Assets/VoiceMorph.png" Width="26" Height="26" Margin="0,0,10,0"/><TextBlock Text="VoiceMorph" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Голосовая мастерская" Foreground="{StaticResource TextTertiaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click" AutomationProperties.Name="Свернуть"><Path Data="M0,0 L10,0" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/></Button><Button Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click" AutomationProperties.Name="Развернуть"><Path Data="M0,0 L10,0 10,10 0,10 Z" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.3"/></Button><Button Style="{StaticResource WindowButtonStyle}" Click="CloseButton_Click" AutomationProperties.Name="Закрыть"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/></Button></StackPanel></Grid></Border>
  <Grid Grid.Row="1" Margin="24,20,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,16"><StackPanel>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="{Binding StatusTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusDetail}" Style="{StaticResource HelperTextStyle}" Margin="0,5,0,0"/></StackPanel>
     <TextBlock Grid.Column="1" Text="Режим обработки" Style="{StaticResource HelperTextStyle}" Margin="0,0,16,6"/>
     <ComboBox x:Name="ProcessingModeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,16,0" SelectedIndex="0" SelectionChanged="ProcessingMode_Changed" AutomationProperties.Name="Режим обработки"><ComboBoxItem Content="DSP · лёгкая обработка"/><ComboBoxItem Content="RVC · голосовые модели"/></ComboBox>
     <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"><Button x:Name="BypassButton" Height="44" Content="{Binding BypassButtonText}" Click="BypassButton_Click" IsEnabled="False" Margin="0,0,12,0"/><Button x:Name="EngineButton" Height="44" Content="{Binding EngineButtonText}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="166" Click="EngineButton_Click"/></StackPanel>
    </Grid>
    <Border x:Name="HeaderErrorBox" Margin="0,16,0,0" Padding="12" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" LineHeight="19"/>
    </Border>
   </StackPanel></Border>
   <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Микрофон" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="InputDeviceComboBox" AutomationProperties.Name="Микрофон"/></StackPanel><TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/><StackPanel Grid.Column="2"><TextBlock Text="Выход в игру / OBS" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="OutputDeviceComboBox" AutomationProperties.Name="Аудиовыход"/></StackPanel><Button x:Name="RefreshDevicesButton" Grid.Column="3" Content="Обновить" Margin="12,25,0,0" Width="100" VerticalAlignment="Bottom" Click="RefreshDevicesButton_Click"/></Grid></Border>
   <TabControl x:Name="MainTabs" Grid.Row="2">
    <TabItem x:Name="DspVoicesTab" Header="Голоса"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Коллекция голосов" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/><TextBlock Text="Выбери характер. Собственный профиль можно собрать по примеру." Style="{StaticResource HelperTextStyle}" Margin="0,0,0,16"/><ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile,Mode=TwoWay}" ItemTemplate="{StaticResource ProfileTemplate}" ItemContainerStyle="{StaticResource ProfileItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><WrapPanel Margin="0,4,0,12"><Button Content="Создать по примеру" Style="{StaticResource PrimaryButtonStyle}" Click="OpenCreate_Click" Margin="0,0,12,8"/><Button Content="Импорт профиля" Click="ImportProfile_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel>
     <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding SelectedProfile.Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedProfile.Description}" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,20"/><TextBlock Text="Сила преобразования" FontWeight="SemiBold"/><Slider Minimum="0" Maximum="1" Value="{Binding Strength,Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="Сила преобразования"/><TextBlock Text="{Binding Strength,StringFormat={}{0:P0}}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,0,0,20"/><TextBlock Text="{Binding ProfileSummary}" Style="{StaticResource HelperTextStyle}" Margin="0,0,0,20"/><Button Content="Создать копию" Click="CopyProfile_Click" Margin="0,0,0,10"/><Button Content="Экспорт профиля" Click="ExportProfile_Click" Margin="0,0,0,20"/><TextBlock Text="Сравнить на своей записи" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="PreviewDryButton" Content="Оригинал" Click="PreviewDry_Click" Padding="8,0"/><Button x:Name="PreviewWetButton" Grid.Column="2" Content="С эффектом" Click="PreviewWet_Click" Padding="8,0"/></Grid><Button x:Name="StopPreviewButton" Content="Остановить" Click="StopPreview_Click" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="PreviewStatus" Text="Нужна калибровка на вкладке «Создать профиль». Слушай в наушниках." Style="{StaticResource HelperTextStyle}" Margin="0,0,0,16"/><Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12"><TextBlock Text="Профиль меняет тембр и динамику. Произношение и манера речи остаются твоими." Style="{StaticResource HelperTextStyle}"/></Border></StackPanel></Border>
    </Grid></ScrollViewer></TabItem>
    <TabItem x:Name="DspCreateTab" Header="Создать профиль"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="01  Твой обычный голос" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Запиши 30 секунд спокойной речи или выбери чистый аудиофайл. Калибровка сохраняется для следующих профилей." Style="{StaticResource HelperTextStyle}" Margin="0,10,0,16"/><WrapPanel><Button x:Name="RecordCalibrationButton" Content="Записать 30 секунд" Click="RecordCalibration_Click" Margin="0,0,12,8"/><Button x:Name="LoadCalibrationButton" Content="Выбрать файл" Click="LoadCalibration_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="CalibrationStatus" Text="Калибровка ещё не выполнена" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="02  Голос для ориентира" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="От 2 минут чистой речи одного человека. Без музыки, чужих голосов и длинной тишины. WAV, MP3, FLAC или видео с аудиодорожкой." Style="{StaticResource HelperTextStyle}" Margin="0,10,0,16"/><Button x:Name="LoadTargetButton" Content="Выбрать пример голоса" Click="LoadTarget_Click" HorizontalAlignment="Left"/><TextBlock x:Name="TargetStatus" Text="Файл не выбран" Style="{StaticResource HelperTextStyle}" Margin="0,16,0,0"/></StackPanel></Border>
     <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="03  Название и подбор" Style="{StaticResource SectionTitleStyle}"/><Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBox x:Name="ProfileNameBox" Text="Мой голос" MaxLength="64" AutomationProperties.Name="Название нового профиля"/><ComboBox Grid.Column="2" x:Name="FitStrengthBox" SelectedIndex="1" AutomationProperties.Name="Интенсивность подбора"><ComboBoxItem Content="Мягкий вариант" Tag="0.5"/><ComboBoxItem Content="Сбалансированный" Tag="0.75"/><ComboBoxItem Content="Выраженный" Tag="1"/></ComboBox></Grid><WrapPanel><Button x:Name="AnalyzeButton" Content="Подобрать и сохранить профиль" Style="{StaticResource PrimaryButtonStyle}" Click="AnalyzeProfile_Click" Margin="0,0,12,0"/><Button x:Name="CancelAnalysisButton" Content="Отмена" Click="CancelAnalysis_Click" Visibility="Collapsed"/></WrapPanel><ProgressBar x:Name="AnalysisProgressBar" Height="5" Minimum="0" Maximum="1" Margin="0,16,0,0" Visibility="Collapsed"/><TextBlock x:Name="AnalysisStatus" Text="Анализ выполняется локально. В эфире работают только аудиофильтры." Style="{StaticResource HelperTextStyle}" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid></ScrollViewer></TabItem>
    <TabItem x:Name="DspSettingsTab" Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Расширенная настройка" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding EditingHint}" Style="{StaticResource HelperTextStyle}" Margin="0,6,12,0"/></StackPanel><Button Grid.Column="1" Content="Сохранить изменения" Click="SaveProfile_Click" IsEnabled="{Binding CanEdit}"/></Grid><ItemsControl ItemsSource="{Binding ParameterGroups}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Parameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,24,16" IsEnabled="{Binding CanEdit}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Foreground="{StaticResource AccentBrush}"/><Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="{Binding Min}" Maximum="{Binding Max}" TickFrequency="{Binding Step}" Value="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" Margin="0,6,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="NeuralModelsTab" Header="RVC-модели">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Библиотека голосовых моделей" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Отдельный нейросетевой режим. .pth — голос, .index — дополнительный поиск тембра." Style="{StaticResource HelperTextStyle}" Margin="0,6,16,0"/></StackPanel>
        <WrapPanel Grid.Column="1"><Button x:Name="ImportArchiveButton" Content="Импорт ZIP" Click="ImportModelArchive_Click" Margin="0,0,8,0"/><Button x:Name="ImportPthButton" Content="Выбрать .pth" Click="ImportModelFiles_Click"/></WrapPanel>
       </Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel>
         <TextBlock x:Name="ModelEmptyText" Text="Импортируй архив или выбери .pth и необязательный .index. Файлы не исполняются при добавлении." Style="{StaticResource HelperTextStyle}" Margin="0,0,0,12"/>
         <ListBox x:Name="NeuralModelsList" ItemContainerStyle="{StaticResource NeuralModelItemStyle}" SelectionChanged="NeuralModel_Changed" MinHeight="180" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Summary}" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <TextBlock x:Name="ModelImportStatus" Text="Модели и движок хранятся на F. Загружай только файлы из доверенного источника: проверка формата не гарантирует безопасность." Style="{StaticResource HelperTextStyle}" Margin="0,12,0,0"/>
        </StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel>
         <TextBlock x:Name="SelectedModelTitle" Text="Модель не выбрана" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock x:Name="SelectedModelDetails" Text="После импорта выбери голос слева." Style="{StaticResource HelperTextStyle}" Margin="0,8,0,20"/>
         <TextBlock Text="Высота голоса" FontWeight="SemiBold"/><Slider x:Name="NeuralPitchSlider" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="NeuralParameters_Changed" AutomationProperties.Name="Высота RVC"/><TextBlock x:Name="NeuralPitchValue" Text="0 полутонов" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,0,0,16"/>
         <TextBlock Text="Влияние индекса" FontWeight="SemiBold"/><Slider x:Name="NeuralIndexSlider" Minimum="0" Maximum="1" Value="0.5" ValueChanged="NeuralParameters_Changed" AutomationProperties.Name="Влияние индекса RVC"/><TextBlock x:Name="NeuralIndexValue" Text="50%" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,0,0,16"/>
         <CheckBox x:Name="TrustIndexCheckBox" Content="Индекс из доверенного источника" Foreground="{StaticResource TextPrimaryBrush}" Checked="NeuralParameters_Changed" Unchecked="NeuralParameters_Changed" Margin="0,0,0,12" ToolTip="FAISS-индекс читается нативным кодом. Включай только для файлов, которым доверяешь."/>
         <TextBlock Text="Запас времени для обработки" FontWeight="SemiBold"/><ComboBox x:Name="NeuralBlockBox" SelectedIndex="1" AutomationProperties.Name="Размер блока RVC"><ComboBoxItem Content="Быстрый · 200 мс" Tag="200"/><ComboBoxItem Content="Баланс · 320 мс" Tag="320"/><ComboBoxItem Content="Стабильный · 480 мс" Tag="480"/></ComboBox>
         <TextBlock Text="Это размер блока, не полная задержка. Нейросетевой режим расходует GPU и память; качество зависит от модели." Style="{StaticResource HelperTextStyle}" Margin="0,12,0,0"/>
        </StackPanel></Border>
       </Grid>
       <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel>
        <TextBlock Text="Движок и проверка голоса" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock x:Name="NeuralRuntimeStatus" Text="Движок RVC не запускается автоматически. Нажми проверку, чтобы увидеть готовность GPU и файлов." Style="{StaticResource HelperTextStyle}" Margin="0,8,0,16"/>
        <WrapPanel><Button x:Name="CheckRuntimeButton" Content="Проверить движок" Click="CheckNeuralRuntime_Click" Margin="0,0,8,8"/><Button x:Name="CheckModelButton" Content="Проверить модель" Click="CheckNeuralModel_Click" Margin="0,0,8,8"/><Button x:Name="NeuralPreviewButton" Content="Проба на своей записи" Click="PreviewNeuralModel_Click" Margin="0,0,8,8"/><Button x:Name="NeuralConvertFileButton" Content="Обработать аудиофайл" Click="ConvertNeuralFile_Click" Margin="0,0,8,8"/><Button x:Name="NeuralUnloadButton" Content="Выгрузить движок" Click="UnloadNeuralRuntime_Click" Margin="0,0,0,8"/><Button x:Name="CancelNeuralButton" Content="Отмена" Click="CancelNeural_Click" Visibility="Collapsed" Margin="8,0,0,8"/></WrapPanel>
        <ProgressBar x:Name="NeuralProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,12"/>
        <TextBlock x:Name="NeuralOperationStatus" Text="Для первого теста лучше обработать короткую запись, затем включать микрофон в игре." Style="{StaticResource HelperTextStyle}"/>
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="OBS"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Голос в стриме и записи" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="VoiceMorph → CABLE Input → CABLE Output → OBS" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,12,0,20"/><TextBlock Text="Добавь «Захват входного аудиопотока» и выбери CABLE Output. Отключи обычный микрофон в микшере OBS, чтобы зрители не слышали два голоса. Для проверки достаточно локальной записи." Style="{StaticResource HelperTextStyle}" MaxWidth="740" HorizontalAlignment="Left"/><Button x:Name="ConfigureObsButton" Content="Подключить к OBS" Click="ConfigureObs_Click" HorizontalAlignment="Left" Margin="0,20,0,12"/><TextBlock x:Name="ObsStatus" Text="Подключение использует локальный obs-websocket на порту 4455." Style="{StaticResource HelperTextStyle}"/></StackPanel></Border></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ResourceText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Вход" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/><ProgressBar Width="85" Height="5" Maximum="100" Value="{Binding InputLevel,Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Выход" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/><ProgressBar Width="80" Height="5" Maximum="100" Value="{Binding OutputLevel,Mode=OneWay}" Foreground="{StaticResource WaveBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding LatencyText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/></Grid></Border>
 </Grid>
</Window>
