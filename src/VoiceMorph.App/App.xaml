  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B7C3D7"/><SolidColorBrush x:Key="TextTertiaryBrush" Color="#9EAEC5"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#77DCC7"/><SolidColorBrush x:Key="AccentSoftBrush" Color="#203C40"/>
